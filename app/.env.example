# ============ KONNEXT 应用环境变量（真值只进 .env.local / Vercel，永不进 git）============

# PostgreSQL 连接串。
# 本地云开发（unix socket）：postgres://root@/konnext_v31?host=/tmp&port=5433
# Supabase：必须用 Supavisor 事务池端口 6543 的连接串（连接数 + IPv4 双原因）
DATABASE_URL=

# 会话加密密钥，>=32 字节随机串（openssl rand -base64 48）
SESSION_SECRET=

# 验证码散列的服务器侧佐料，>=32 字节随机串。6 位数字码空间太小，纯散列会被秒破
OTP_PEPPER=

# 短信通道：twilio=真发 | console=打到服务器日志 | fixed=固定码 000000（演示/预发）
# ★生产必须 twilio —— 代码里有保险丝，生产配 console/fixed 会整体拒绝启动
OTP_TRANSPORT=fixed

# 仅预发：允许 GET /api/dev/otp?phone=... 查最新验证码（生产配 true 会拒绝启动）
ALLOW_DEV_OTP_ENDPOINT=false

# Twilio（等注册指南办完后填）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 邮箱验证码通道（管理员双重验证）：console | resend
EMAIL_TRANSPORT=console
RESEND_API_KEY=
